# Copy to .env (never commit .env). All variables are optional in development.
LUNARIS_ENV=development                 # development | test | production
# Dev default is a local SQLite file (documented dev fallback). Production REQUIRES PostgreSQL.
LUNARIS_DATABASE_URL=sqlite:///./.data/lunaris_dev.db
# LUNARIS_DATABASE_URL=postgresql://lunaris:CHANGE_ME@localhost:5432/lunaris
LUNARIS_SESSION_SECRET=                 # >=32 random chars; REQUIRED in production. Empty in dev => ephemeral.
LUNARIS_SESSION_TTL_DAYS=30
LUNARIS_CORS_ALLOW_ORIGINS=http://localhost:3000   # comma-separated explicit origins; '*' is rejected
LUNARIS_MAX_REQUEST_BYTES=65536
LUNARIS_RATE_LIMIT_READ_PER_MIN=120
LUNARIS_RATE_LIMIT_WRITE_PER_MIN=30
LUNARIS_RATE_LIMIT_SESSION_PER_HOUR=10
LUNARIS_TRUST_PROXY_HEADERS=false       # true ONLY behind a proxy that appends X-Forwarded-For
LUNARIS_WEATHER_CACHE_TTL_SECONDS=900
LUNARIS_WEATHER_STALE_MAX_SECONDS=21600 # how old a cached forecast may be when upstream is down
LUNARIS_AUTO_CREATE_SCHEMA=true         # dev convenience (create_all + seed cities); false in production, use Alembic
LUNARIS_SEED_DEMO_DATA=true             # seeds ONE clearly-labelled DEMO mission
LUNARIS_DOCS_ENABLED=true               # /docs and /openapi.json (default false in production)
LUNARIS_LOG_LEVEL=INFO
LUNARIS_AUTH_MODE=guest_session         # only value implemented. Email auth is NOT implemented.

# Provider bindings supplied by other agents' packages, as "module:attr" (class, factory or instance).
# Unset => that capability reports not_integrated and its routes answer 503 / empty+labelled. Nothing is faked.
# Verified built-in integrations (no API key required for non-commercial Open-Meteo use):
LUNARIS_WEATHER_PROVIDER=lunaris_api.integrations.builtin:OpenMeteoWeatherProvider
LUNARIS_CLIMATE_ENGINE=lunaris_api.integrations.builtin:ComfortWindowEngine
LUNARIS_CHOICES_ENGINE=lunaris_api.integrations.builtin:VerifiedChoicesEngine
# LUNARIS_PLACES_PROVIDER=
# LUNARIS_BUSINESS_EVIDENCE_PROVIDER=

# docker-compose only:
POSTGRES_PASSWORD=change-me-locally

# Optional trained ML artifact directory. When absent the AI endpoints accurately report untrained.
# LUNARIS_MODEL_DIR=/absolute/path/to/artifacts
