{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/lumi.py": {
      "maxDuration": 20,
      "includeFiles": "{packages/choices/src/lunaris_choices/data/factors.json,services/api/src/lunaris_api/action_atlas/catalog.py,dist/app/app.js}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
