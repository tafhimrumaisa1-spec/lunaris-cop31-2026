# Copy to .env.release, set strong unique credentials, and do NOT commit.
POSTGRES_PASSWORD=REPLACE_WITH_40_CHAR_URL_SAFE_PASSWORD
LUNARIS_SESSION_SECRET=REPLACE_WITH_UNIQUE_50_CHAR_RANDOM_SECRET
PUBLIC_ORIGIN=https://your-public-site.example
LUNARIS_HTTP_PORT=8080

# Vercel Lumi function. Configure in Vercel Project Settings; never commit a real key.
GROQ_API_KEY=REPLACE_WITH_GROQ_SECRET
GROQ_MODEL=openai/gpt-oss-20b
